#!/usr/bin/env bash
# ==============================================================================
# Script: init-context
# Repository: https://github.com/Cyber-arghya/auto-context
# Author: Arghya Biswas (@Cyber-arghya)
# License: MIT
# Purpose: Autonomous context & instruction management scaffolding for AI coding assistants
# ==============================================================================
set -euo pipefail

VERSION="1.0.0"

# Colors
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

# Defaults
FORCE=false
DRY_RUN=false
TARGET_DIR="$(pwd)"
NEW_RULE=""
NEW_SKILL=""
IS_GLOBAL=false

# MCP Defaults
ADD_MCP=""
REMOVE_MCP=""
LIST_MCP=false
MCP_PRESET=""
MCP_RUNTIME=""
MCP_COMMAND=""
MCP_ARGS=""
MCP_URL=""
MCP_ENV=""
MCP_ENV_VAR=""
MCP_ENV_FILE=""

show_help() {
    printf "%binit-context%b - Autonomous Context, Instruction & Tool Manager for AI Coding Agents\n\n" "$BOLD" "$NC"
    printf "%bUSAGE:%b\n" "$BOLD" "$NC"
    printf "    init-context [OPTIONS] [DIRECTORY]\n\n"
    printf "%bOPTIONS (CONTEXT & RULES):%b\n" "$BOLD" "$NC"
    printf "    -r, --new-rule <NAME>     Scaffold a new agent rule (.agents/rules/<name>.md)\n"
    printf "    -s, --new-skill <NAME>    Scaffold a new skill (.agents/skills/<name>/SKILL.md)\n"
    printf "    -g, --global              Target global plugin scope (~/.gemini/config/plugins/auto-context/)\n"
    printf "    -f, --force               Overwrite existing files\n"
    printf "    -d, --dry-run             Preview generated files without writing to disk\n"
    printf "    -v, --version             Display current version (%s)\n" "$VERSION"
    printf "    -h, --help                Show this help message\n\n"
    printf "%bOPTIONS (MCP TOOLING & SECRETS):%b\n" "$BOLD" "$NC"
    printf "    --add-mcp <NAME>          Add or update an MCP server configuration\n"
    printf "    --remove-mcp <NAME>       Remove an MCP server configuration\n"
    printf "    --list-mcp                List all active MCP server tools\n"
    printf "    --preset <PRESET>         Preset template (sqlite, git, fetch, time, duckdb, postgres, github, filesystem, brave)\n"
    printf "    --runtime, --runner <CMD> Package runner for stdio tools: uvx (Python) or npx (Node)\n"
    printf "    --env-var <NAME>          Environment variable holding secret (e.g. GITHUB_TOKEN)\n"
    printf "    --env-file <PATH>         Path to .env file (default: .env)\n"
    printf "    --command <CMD>           Executable command for stdio server (e.g. npx, uvx, python3)\n"
    printf "    --args <ARGS>             Arguments to pass to command (e.g. 'path/to/db.sqlite')\n"
    printf "    --url <URL>               Streamable HTTP endpoint URL for remote MCP server\n"
    printf "    --env <KEY=VAL,...>       Explicit environment variable mapping\n\n"
    printf "%bEXAMPLES:%b\n" "$BOLD" "$NC"
    printf "    init-context                              # Initialize current project\n"
    printf "    init-context -r code-standards            # Create a new local rule\n"
    printf "    init-context -s deploy-docker             # Create a new local skill\n"
    printf "    init-context --add-mcp sqlite             # Add SQLite MCP (auto uvx vs npx)\n"
    printf "    init-context --add-mcp sqlite --runtime uvx # Force Python uvx runner\n"
    printf "    init-context --add-mcp git --runtime uvx  # Add Python Git MCP server\n"
    printf "    init-context --add-mcp duckdb             # Add DuckDB MCP server (Python uvx)\n"
    printf "    init-context --add-mcp github             # Add GitHub MCP server (references .env)\n"
    printf "    init-context --add-mcp postgres           # Add Postgres MCP server (references .env)\n"
    printf "    init-context --list-mcp                   # List all configured MCP tools\n\n"
    printf "%bDOCUMENTATION:%b\n" "$BOLD" "$NC"
    printf "    https://github.com/Cyber-arghya/auto-context\n"
}

# Parse flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            echo "init-context version $VERSION"
            exit 0
            ;;
        -f|--force)
            FORCE=true
            shift
            ;;
        -d|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -g|--global)
            IS_GLOBAL=true
            shift
            ;;
        -r|--new-rule)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}[✗] Error: --new-rule requires a rule name${NC}"
                exit 1
            fi
            NEW_RULE="$2"
            shift 2
            ;;
        -s|--new-skill)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}[✗] Error: --new-skill requires a skill name${NC}"
                exit 1
            fi
            NEW_SKILL="$2"
            shift 2
            ;;
        --add-mcp)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}[✗] Error: --add-mcp requires a server name${NC}"
                exit 1
            fi
            ADD_MCP="$2"
            shift 2
            ;;
        --remove-mcp|--delete-mcp)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}[✗] Error: --remove-mcp requires a server name${NC}"
                exit 1
            fi
            REMOVE_MCP="$2"
            shift 2
            ;;
        --list-mcp)
            LIST_MCP=true
            shift
            ;;
        --preset)
            MCP_PRESET="$2"
            shift 2
            ;;
        --runtime|--runner)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}[✗] Error: --runtime requires a value (uvx or npx)${NC}"
                exit 1
            fi
            MCP_RUNTIME="$2"
            shift 2
            ;;
        --command)
            MCP_COMMAND="$2"
            shift 2
            ;;
        --args)
            MCP_ARGS="$2"
            shift 2
            ;;
        --url)
            MCP_URL="$2"
            shift 2
            ;;
        --env)
            MCP_ENV="$2"
            shift 2
            ;;
        --env-var)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}[✗] Error: --env-var requires a variable name${NC}"
                exit 1
            fi
            MCP_ENV_VAR="$2"
            shift 2
            ;;
        --env-file)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}[✗] Error: --env-file requires a file path${NC}"
                exit 1
            fi
            MCP_ENV_FILE="$2"
            shift 2
            ;;
        -*)
            echo -e "${RED}[✗] Unknown option: $1${NC}"
            show_help
            exit 1
            ;;
        *)
            TARGET_DIR="$1"
            shift
            ;;
    esac
done

# ------------------------------------------------------------------------------
# Action 1: Scaffold a New Rule
# ------------------------------------------------------------------------------
if [ -n "$NEW_RULE" ]; then
    CLEAN_RULE_NAME=$(echo "$NEW_RULE" | tr '[:upper:]' '[:lower:]' | tr ' _' '-' | sed 's/\.md$//')
    RULE_TITLE=$(echo "$CLEAN_RULE_NAME" | tr '-' ' ' | awk '{for(i=1;i<=NF;i++)sub(/./,toupper(substr($i,1,1)),$i)}1')

    if [ "$IS_GLOBAL" = true ]; then
        DEST_DIR="$HOME/.gemini/config/plugins/auto-context/rules"
        SCOPE_LABEL="GLOBAL Plugin (~/.gemini/config/plugins/auto-context/rules)"
    else
        DEST_DIR="$TARGET_DIR/.agents/rules"
        SCOPE_LABEL="LOCAL Project ($DEST_DIR)"
    fi

    DEST_FILE="$DEST_DIR/${CLEAN_RULE_NAME}.md"

    if [ -f "$DEST_FILE" ] && [ "$FORCE" = false ]; then
        echo -e "${YELLOW}[!] Rule already exists at: $DEST_FILE${NC}"
        echo -e "    Use ${CYAN}--force${NC} to overwrite."
        exit 1
    fi

    if [ "$DRY_RUN" = true ]; then
        echo -e "${YELLOW}[!] Dry-run: Would create rule at: $DEST_FILE${NC}"
        exit 0
    fi

    mkdir -p "$DEST_DIR"
    cat << RULE_TPL_EOF > "$DEST_FILE"
---
name: ${CLEAN_RULE_NAME}
description: Rule guidelines and constraints for ${CLEAN_RULE_NAME}. Explain when and how the agent should apply this rule.
trigger: always_on
---

# Rule: ${RULE_TITLE}

## Objective
Define the goal and purpose of this rule.

## Guidelines & Constraints
- **Constraint 1:** Specific coding standards, naming conventions, or prohibited patterns.
- **Constraint 2:** Security protocols, credential management, or access boundaries.
- **Constraint 3:** Testing or documentation requirements.

## Enforcement
AI coding agents (Antigravity, Cursor, Claude Code, Copilot) operating in this workspace must adhere strictly to these instructions.
RULE_TPL_EOF

    echo -e "\n${CYAN}=====================================================================${NC}"
    echo -e "${GREEN}✨ New Rule Created Successfully!${NC}"
    echo -e "   Name:   ${YELLOW}${CLEAN_RULE_NAME}${NC}"
    echo -e "   Scope:  ${CYAN}${SCOPE_LABEL}${NC}"
    echo -e "   File:   ${GREEN}${DEST_FILE}${NC}"
    echo -e "${CYAN}=====================================================================${NC}\n"
    exit 0
fi

# ------------------------------------------------------------------------------
# Action 2: Scaffold a New Skill
# ------------------------------------------------------------------------------
if [ -n "$NEW_SKILL" ]; then
    CLEAN_SKILL_NAME=$(echo "$NEW_SKILL" | tr '[:upper:]' '[:lower:]' | tr ' _' '-')
    SKILL_TITLE=$(echo "$CLEAN_SKILL_NAME" | tr '-' ' ' | awk '{for(i=1;i<=NF;i++)sub(/./,toupper(substr($i,1,1)),$i)}1')

    if [ "$IS_GLOBAL" = true ]; then
        DEST_DIR="$HOME/.gemini/config/plugins/auto-context/skills/${CLEAN_SKILL_NAME}"
        SCOPE_LABEL="GLOBAL Plugin (~/.gemini/config/plugins/auto-context/skills)"
    else
        DEST_DIR="$TARGET_DIR/.agents/skills/${CLEAN_SKILL_NAME}"
        SCOPE_LABEL="LOCAL Project ($DEST_DIR)"
    fi

    DEST_FILE="$DEST_DIR/SKILL.md"

    if [ -f "$DEST_FILE" ] && [ "$FORCE" = false ]; then
        echo -e "${YELLOW}[!] Skill already exists at: $DEST_FILE${NC}"
        echo -e "    Use ${CYAN}--force${NC} to overwrite."
        exit 1
    fi

    if [ "$DRY_RUN" = true ]; then
        echo -e "${YELLOW}[!] Dry-run: Would create skill at: $DEST_FILE${NC}"
        exit 0
    fi

    mkdir -p "$DEST_DIR"
    cat << SKILL_TPL_EOF > "$DEST_FILE"
---
name: ${CLEAN_SKILL_NAME}
description: Describe what this skill accomplishes and the specific keywords or conditions under which the agent should activate it.
---

# Skill: ${SKILL_TITLE}

## Overview
Briefly summarize the procedure, workflows, or runbooks taught by this skill.

## When to Activate
- When the user asks to perform task X.
- When working on subsystem Y or diagnosing error Z.

## Workflow & Step-by-Step Instructions

### Step 1: Pre-flight & Checks
* Validate prerequisites, environment variables, or dependencies:
  \`\`\`bash
  # Check command
  \`\`\`

### Step 2: Core Execution
* Follow this exact procedure:
  \`\`\`bash
  # Execution command
  \`\`\`

### Step 3: Verification
* Verify the expected outcome:
  \`\`\`bash
  # Verification command
  \`\`\`

## Reference & Troubleshooting
* Common pitfalls and their solutions.
SKILL_TPL_EOF

    echo -e "\n${CYAN}=====================================================================${NC}"
    echo -e "${GREEN}🎯 New Skill Created Successfully!${NC}"
    echo -e "   Name:   ${YELLOW}${CLEAN_SKILL_NAME}${NC}"
    echo -e "   Scope:  ${CYAN}${SCOPE_LABEL}${NC}"
    echo -e "   File:   ${GREEN}${DEST_FILE}${NC}"
    echo -e "${CYAN}=====================================================================${NC}\n"
    exit 0
fi

# ------------------------------------------------------------------------------
# Action 3: List MCP Servers
# ------------------------------------------------------------------------------
if [ "$LIST_MCP" = true ]; then
    if [ "$IS_GLOBAL" = true ]; then
        MCP_FILE="$HOME/.gemini/config/mcp_config.json"
        SCOPE_LABEL="GLOBAL (~/.gemini/config/mcp_config.json)"
    else
        MCP_FILE="$TARGET_DIR/.gemini/mcp_config.json"
        [ -f "$MCP_FILE" ] || MCP_FILE="$TARGET_DIR/.agents/mcp_config.json"
        SCOPE_LABEL="LOCAL ($MCP_FILE)"
    fi

    echo -e "\n${CYAN}=====================================================================${NC}"
    echo -e "${BOLD}${GREEN}🔌 Registered MCP Servers: ${YELLOW}${SCOPE_LABEL}${NC}"
    echo -e "${CYAN}=====================================================================${NC}"

    if [ ! -f "$MCP_FILE" ]; then
        echo -e "   ${YELLOW}[!] No MCP configuration found at: $MCP_FILE${NC}"
        echo -e "   Run 'init-context --add-mcp <name>' to register an MCP tool.\n"
        exit 0
    fi

    python3 -c "
import json, sys
try:
    with open('$MCP_FILE', 'r') as f:
        data = json.load(f)
    servers = data.get('mcpServers', {})
    if not servers:
        print('   No MCP servers registered.')
        sys.exit(0)
    print(f'   {\"NAME\":<20} {\"TYPE\":<8} {\"ENDPOINT / COMMAND\"}')
    print('   ' + '-'*60)
    for name, cfg in servers.items():
        if 'url' in cfg:
            print(f'   {name:<20} {\"http\":<8} {cfg[\"url\"]}')
        elif 'command' in cfg:
            cmd = cfg['command'] + ' ' + ' '.join(cfg.get('args', []))
            if len(cmd) > 40: cmd = cmd[:37] + '...'
            print(f'   {name:<20} {\"stdio\":<8} {cmd}')
        else:
            print(f'   {name:<20} {\"unknown\":<8}')
except Exception as e:
    print(f'Error reading MCP file: {e}')
"
    echo -e "${CYAN}=====================================================================${NC}\n"
    exit 0
fi

# ------------------------------------------------------------------------------
# Action 4: Remove MCP Server
# ------------------------------------------------------------------------------
if [ -n "$REMOVE_MCP" ]; then
    if [ "$IS_GLOBAL" = true ]; then
        MCP_FILES=("$HOME/.gemini/config/mcp_config.json" "$HOME/.gemini/config/plugins/auto-context/mcp_config.json")
        SCOPE_LABEL="GLOBAL"
    else
        MCP_FILES=("$TARGET_DIR/.gemini/mcp_config.json" "$TARGET_DIR/.agents/mcp_config.json")
        SCOPE_LABEL="LOCAL"
    fi

    FOUND=false
    for f in "${MCP_FILES[@]}"; do
        if [ -f "$f" ]; then
            python3 -c "
import json
with open('$f', 'r') as fp:
    d = json.load(fp)
if 'mcpServers' in d and '$REMOVE_MCP' in d['mcpServers']:
    del d['mcpServers']['$REMOVE_MCP']
    with open('$f', 'w') as fp:
        json.dump(d, fp, indent=2)
"
            FOUND=true
        fi
    done

    echo -e "\n${CYAN}=====================================================================${NC}"
    if [ "$FOUND" = true ]; then
        echo -e "${GREEN}🗑️  Removed MCP Server: ${YELLOW}$REMOVE_MCP${GREEN} (${SCOPE_LABEL})${NC}"
    else
        echo -e "${YELLOW}[!] MCP Server '$REMOVE_MCP' was not found in $SCOPE_LABEL configuration.${NC}"
    fi
    echo -e "${CYAN}=====================================================================${NC}\n"
    exit 0
fi

# ------------------------------------------------------------------------------
# Action 5: Add or Update MCP Server (Secure Secret-Handling via .env / Env Vars)
# ------------------------------------------------------------------------------
if [ -n "$ADD_MCP" ]; then
    SERVER_NAME=$(echo "$ADD_MCP" | tr '[:upper:]' '[:lower:]' | tr ' _' '-')

    PRESET="${MCP_PRESET:-$SERVER_NAME}"
    CMD=""
    ARGS_JSON="[]"
    ENV_JSON="{}"
    URL=""
    SECURE_VAR_NAME=""
    ENV_PLACEHOLDER=""
    RAW_SECRET_PASSED=""

    # Determine runtime preference (uvx vs npx)
    RUNNER="${MCP_RUNTIME:-}"
    if [ -z "$RUNNER" ]; then
        if [ "$PRESET" = "duckdb" ] || [ "$PRESET" = "time" ]; then
            RUNNER="uvx"
        elif [ -f "$TARGET_DIR/pyproject.toml" ] || [ -f "$TARGET_DIR/requirements.txt" ] || [ -f "$TARGET_DIR/Pipfile" ] || [ -f "$TARGET_DIR/setup.py" ]; then
            if command -v uvx >/dev/null 2>&1; then
                RUNNER="uvx"
            else
                RUNNER="npx"
            fi
        else
            RUNNER="npx"
        fi
    fi

    if [ "$PRESET" = "sqlite" ]; then
        DB_PATH="${MCP_ARGS:-database.db}"
        if [ "$RUNNER" = "uvx" ] || [ "$RUNNER" = "python" ]; then
            CMD="uvx"
            ARGS_JSON="[\"mcp-server-sqlite\", \"--db-path\", \"$DB_PATH\"]"
        else
            CMD="npx"
            ARGS_JSON="[\"-y\", \"@modelcontextprotocol/server-sqlite\", \"$DB_PATH\"]"
        fi
    elif [ "$PRESET" = "git" ]; then
        REPO_PATH="${MCP_ARGS:-$TARGET_DIR}"
        if [ "$RUNNER" = "uvx" ] || [ "$RUNNER" = "python" ]; then
            CMD="uvx"
            ARGS_JSON="[\"mcp-server-git\", \"--repository\", \"$REPO_PATH\"]"
        else
            CMD="npx"
            ARGS_JSON="[\"-y\", \"@modelcontextprotocol/server-git\", \"$REPO_PATH\"]"
        fi
    elif [ "$PRESET" = "duckdb" ]; then
        CMD="uvx"
        DB_PATH="${MCP_ARGS:-database.duckdb}"
        ARGS_JSON="[\"duckdb-mcp\", \"--db-path\", \"$DB_PATH\"]"
    elif [ "$PRESET" = "time" ]; then
        CMD="uvx"
        ARGS_JSON="[\"mcp-server-time\"]"
    elif [ "$PRESET" = "fetch" ]; then
        if [ "$RUNNER" = "uvx" ] || [ "$RUNNER" = "python" ]; then
            CMD="uvx"
            ARGS_JSON="[\"mcp-server-fetch\"]"
        else
            CMD="npx"
            ARGS_JSON="[\"-y\", \"@modelcontextprotocol/server-fetch\"]"
        fi
    elif [ "$PRESET" = "postgres" ] || [ "$PRESET" = "postgresql" ]; then
        CMD="npx"
        SECURE_VAR_NAME="${MCP_ENV_VAR:-DATABASE_URL}"
        ENV_PLACEHOLDER="postgresql://username:password@localhost:5432/mydb"
        if [ -n "$MCP_ARGS" ] && [[ "$MCP_ARGS" == postgres* ]]; then
            RAW_SECRET_PASSED="$MCP_ARGS"
        fi
        ARGS_JSON="[\"-y\", \"@modelcontextprotocol/server-postgres\", \"\${${SECURE_VAR_NAME}}\"]"
    elif [ "$PRESET" = "github" ]; then
        CMD="npx"
        ARGS_JSON="[\"-y\", \"@modelcontextprotocol/server-github\"]"
        SECURE_VAR_NAME="${MCP_ENV_VAR:-GITHUB_PERSONAL_ACCESS_TOKEN}"
        ENV_PLACEHOLDER="ghp_yourPersonalAccessTokenHere"
        if [ -n "$MCP_ARGS" ]; then
            RAW_SECRET_PASSED="$MCP_ARGS"
        fi
        ENV_JSON="{\"GITHUB_PERSONAL_ACCESS_TOKEN\": \"\${${SECURE_VAR_NAME}}\"}"
    elif [ "$PRESET" = "filesystem" ]; then
        CMD="npx"
        DIR_PATH="${MCP_ARGS:-$TARGET_DIR}"
        ARGS_JSON="[\"-y\", \"@modelcontextprotocol/server-filesystem\", \"$DIR_PATH\"]"
    elif [ "$PRESET" = "brave" ] || [ "$PRESET" = "brave-search" ]; then
        CMD="npx"
        ARGS_JSON="[\"-y\", \"@modelcontextprotocol/server-brave-search\"]"
        SECURE_VAR_NAME="${MCP_ENV_VAR:-BRAVE_API_KEY}"
        ENV_PLACEHOLDER="your_brave_api_key_here"
        if [ -n "$MCP_ARGS" ]; then
            RAW_SECRET_PASSED="$MCP_ARGS"
        fi
        ENV_JSON="{\"BRAVE_API_KEY\": \"\${${SECURE_VAR_NAME}}\"}"
    elif [ -n "$MCP_URL" ]; then
        URL="$MCP_URL"
    elif [ -n "$MCP_COMMAND" ]; then
        CMD="$MCP_COMMAND"
        if [ -n "$MCP_ARGS" ]; then
            ARGS_JSON=$(python3 -c "import json; print(json.dumps('$MCP_ARGS'.split()))")
        fi
        if [ -n "$MCP_ENV_VAR" ]; then
            SECURE_VAR_NAME="$MCP_ENV_VAR"
            ENV_PLACEHOLDER="your_${SECURE_VAR_NAME}_secret_here"
            ENV_JSON="{\"${SECURE_VAR_NAME}\": \"\${${SECURE_VAR_NAME}}\"}"
        fi
    else
        if [ "$RUNNER" = "uvx" ] || [ "$RUNNER" = "python" ]; then
            CMD="uvx"
            ARGS_JSON="[\"mcp-server-$SERVER_NAME\"]"
        else
            CMD="npx"
            ARGS_JSON="[\"-y\", \"@modelcontextprotocol/server-$SERVER_NAME\"]"
        fi
        if [ -n "$MCP_ENV_VAR" ]; then
            SECURE_VAR_NAME="$MCP_ENV_VAR"
            ENV_PLACEHOLDER="your_${SECURE_VAR_NAME}_secret_here"
            ENV_JSON="{\"${SECURE_VAR_NAME}\": \"\${${SECURE_VAR_NAME}}\"}"
        fi
    fi

    if [ -n "$MCP_ENV" ]; then
        ENV_JSON=$(python3 -c "
import json
env_str = '$MCP_ENV'
base_env = json.loads('''$ENV_JSON''')
for item in env_str.split(','):
    if '=' in item:
        k, v = item.split('=', 1)
        base_env[k.strip()] = v.strip()
print(json.dumps(base_env))
")
    fi

    # --------------------------------------------------------------------------
    # Secret-Handling Security: .env, .env.example, and .gitignore Protection
    # --------------------------------------------------------------------------
    if [ -n "$SECURE_VAR_NAME" ] && [ "$IS_GLOBAL" = false ]; then
        DOTENV="$TARGET_DIR/.env"
        DOTENV_EXAMPLE="$TARGET_DIR/.env.example"
        GITIGNORE="$TARGET_DIR/.gitignore"

        # 1. Populate .env.example with safe placeholder
        if [ ! -f "$DOTENV_EXAMPLE" ] || ! grep -q "^${SECURE_VAR_NAME}=" "$DOTENV_EXAMPLE" 2>/dev/null; then
            echo "${SECURE_VAR_NAME}=${ENV_PLACEHOLDER}" >> "$DOTENV_EXAMPLE"
            echo -e "   ${GREEN}[✓] Added placeholder to:${NC} .env.example"
        fi

        # 2. If raw secret was passed via CLI, migrate to .env (chmod 600)
        if [ -n "$RAW_SECRET_PASSED" ]; then
            touch "$DOTENV"
            chmod 600 "$DOTENV"
            if ! grep -q "^${SECURE_VAR_NAME}=" "$DOTENV" 2>/dev/null; then
                echo "${SECURE_VAR_NAME}=${RAW_SECRET_PASSED}" >> "$DOTENV"
                echo -e "   ${YELLOW}[🔒 Security Hardening]${NC} Raw secret safely saved to ${YELLOW}.env${NC} (chmod 600)."
                echo -e "       Plaintext secret was NOT stored in mcp_config.json."
            fi
        fi

        # 3. Ensure .env is protected in .gitignore
        if [ -f "$GITIGNORE" ]; then
            if ! grep -q "^\.env$" "$GITIGNORE" 2>/dev/null; then
                printf "\n# Security: Environment secrets\n.env\n.env.local\n.env.*.local\n" >> "$GITIGNORE"
                echo -e "   ${GREEN}[✓] Protected .env from Git in:${NC} .gitignore"
            fi
        else
            cat << 'GI_EOF' > "$GITIGNORE"
# Security: Environment secrets
.env
.env.local
.env.*.local
node_modules/
GI_EOF
            echo -e "   ${GREEN}[✓] Created .gitignore with .env protection.${NC}"
        fi
    fi

    if [ "$IS_GLOBAL" = true ]; then
        TARGET_MCP_DIRS=("$HOME/.gemini/config" "$HOME/.gemini/config/plugins/auto-context")
        SCOPE_LABEL="GLOBAL (~/.gemini/config/mcp_config.json)"
    else
        TARGET_MCP_DIRS=("$TARGET_DIR/.gemini" "$TARGET_DIR/.agents")
        SCOPE_LABEL="LOCAL ($TARGET_DIR/.gemini/mcp_config.json)"
    fi

    for d in "${TARGET_MCP_DIRS[@]}"; do
        mkdir -p "$d"
        CFG_PATH="$d/mcp_config.json"
        python3 -c "
import json, os

cfg_path = '$CFG_PATH'
name = '$SERVER_NAME'
url = '$URL'
cmd = '$CMD'
args = json.loads('''$ARGS_JSON''')
env = json.loads('''$ENV_JSON''')

data = {'mcpServers': {}}
if os.path.exists(cfg_path):
    try:
        with open(cfg_path, 'r') as fp:
            data = json.load(fp)
    except:
        pass

if 'mcpServers' not in data:
    data['mcpServers'] = {}

server_cfg = {}
if url:
    server_cfg['url'] = url
else:
    server_cfg['command'] = cmd
    if args:
        server_cfg['args'] = args
    if env:
        server_cfg['env'] = env

data['mcpServers'][name] = server_cfg

with open(cfg_path, 'w') as fp:
    json.dump(data, fp, indent=2)
"
    done

    echo -e "\n${CYAN}=====================================================================${NC}"
    echo -e "${GREEN}🔌 MCP Server Configured Successfully!${NC}"
    echo -e "   Server Name: ${YELLOW}${SERVER_NAME}${NC}"
    echo -e "   Scope:       ${CYAN}${SCOPE_LABEL}${NC}"
    if [ -n "$URL" ]; then
        echo -e "   Transport:   ${GREEN}Streamable HTTP ($URL)${NC}"
    else
        echo -e "   Transport:   ${GREEN}Stdio ($CMD)${NC}"
        if [ -n "$RUNNER" ]; then
            echo -e "   Runtime:     ${PURPLE}${RUNNER}${NC}"
        fi
        echo -e "   Arguments:   ${YELLOW}$ARGS_JSON${NC}"
        if [ "$ENV_JSON" != "{}" ]; then
            echo -e "   Environment: ${CYAN}$ENV_JSON${NC}"
        fi
    fi
    if [ -n "$SECURE_VAR_NAME" ]; then
        echo -e "   ${GREEN}🔒 Secret Safety:${NC} Token referenced via ${YELLOW}\${${SECURE_VAR_NAME}}${NC} (stored in .env / env vars)"
    fi
    echo -e "${CYAN}=====================================================================${NC}"
    echo -e "   ${YELLOW}[i] Session Notice:${NC} Host clients (Antigravity, Cursor, Claude Desktop) discover MCP tools at session start."
    echo -e "       ${BOLD}Reload window or start a new chat${NC} to activate native MCP tool calls."
    echo -e "       For immediate mid-flight execution in this session, use CLI tools (e.g. sqlite3, gh, curl).\n"
    exit 0
fi

if [ ! -d "$TARGET_DIR" ]; then
    mkdir -p "$TARGET_DIR"
fi

cd "$TARGET_DIR"
PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR")"
DATE_NOW="$(date +"%Y-%m-%d")"

# Tech stack detector
STACK="General / Multi-stack"
FRAMEWORK="Not detected"

if [ -f "package.json" ]; then
    STACK="Node.js / JavaScript / TypeScript"
    if grep -q "next" package.json 2>/dev/null; then FRAMEWORK="Next.js";
    elif grep -q "react" package.json 2>/dev/null; then FRAMEWORK="React";
    elif grep -q "vue" package.json 2>/dev/null; then FRAMEWORK="Vue.js";
    elif grep -q "express" package.json 2>/dev/null; then FRAMEWORK="Express.js";
    elif grep -q "fastify" package.json 2>/dev/null; then FRAMEWORK="Fastify";
    elif grep -q "nest" package.json 2>/dev/null; then FRAMEWORK="NestJS"; fi
elif [ -f "requirements.txt" ] || [ -f "pyproject.toml" ] || [ -f "Pipfile" ]; then
    STACK="Python"
    if [ -f "manage.py" ]; then FRAMEWORK="Django";
    elif grep -q -i "fastapi" requirements.txt pyproject.toml 2>/dev/null; then FRAMEWORK="FastAPI";
    elif grep -q -i "flask" requirements.txt pyproject.toml 2>/dev/null; then FRAMEWORK="Flask"; fi
elif [ -f "go.mod" ]; then
    STACK="Go (Golang)"
    FRAMEWORK="Standard Go Modules"
elif [ -f "Cargo.toml" ]; then
    STACK="Rust"
    FRAMEWORK="Cargo Package"
elif [ -f "pom.xml" ] || [ -f "build.gradle" ]; then
    STACK="Java / Kotlin"
    FRAMEWORK="Maven / Gradle"
elif [ -f "docker-compose.yml" ] || [ -f "Dockerfile" ]; then
    STACK="Dockerized Container"
fi

echo -e "\n${CYAN}=====================================================================${NC}"
echo -e "${BOLD}${GREEN}🚀 Auto-Context: Initializing Autonomous Context Manager${NC}"
echo -e "   Target Project: ${YELLOW}$PROJECT_NAME${NC} ($PROJECT_DIR)"
echo -e "   Detected Stack: ${CYAN}$STACK${NC} (Framework: $FRAMEWORK)"
echo -e "${CYAN}=====================================================================${NC}\n"

if [ "$DRY_RUN" = true ]; then
    echo -e "${YELLOW}[!] Dry-run mode: No files will be modified.${NC}\n"
fi

# 1. Rules directory
if [ "$DRY_RUN" = false ]; then
    mkdir -p "$PROJECT_DIR/.agents/rules"
fi

# 2. .agents/rules/maintain_context.md
RULE_FILE="$PROJECT_DIR/.agents/rules/maintain_context.md"
if [ ! -f "$RULE_FILE" ] || [ "$FORCE" = true ]; then
    if [ "$DRY_RUN" = false ]; then
cat << 'RULE_EOF' > "$RULE_FILE"
---
name: maintain_context
description: Mandates autonomous, continuous synchronization of context.md and proactive rule/skill learning on any repository or server configuration change without requiring user prompting.
trigger: always_on
---

# Autonomous Context Maintenance & Self-Evolution Rule

1. **Mandatory Synchronization**: Every agent working in this workspace MUST inspect and update `context.md` before finishing their turn whenever any of the following occur:
   - Script or configuration edits (environment variables, docker-compose, configs, network parameters).
   - Problem diagnosis, debugging steps, and technical solutions.
   - User credentials, tokens, secrets, or permissions changes.
   - Architectural decisions or operational runbooks.

2. **Autonomous Learning & Skill Crystallization**:
   - Whenever a new pattern, user preference, architectural guideline, or multi-step procedure is discovered or instructed:
     - Scaffolds a **Rule** (`init-context -r <name> [-g]`) if it is a constraint, coding standard, or guideline.
     - Scaffolds a **Skill** (`init-context -s <name> [-g]`) if it is a multi-step procedure or deployment runbook.
     - Populates the file with clear instructions and notifies the user.

3. **CLI Tool Availability**:
   - The agent has full access to run `init-context` directly via terminal:
     - `init-context`: Initialize/repair context.
     - `init-context -r <name> [-g]`: Create rule.
     - `init-context -s <name> [-g]`: Create skill.

4. **No User Reminder Needed**: The user must never need to ask the agent to update `context.md` or learn rules. This is a strict automated post-condition for all actions.
RULE_EOF
    fi
    echo -e "  ${GREEN}[✓] Generated:${NC} .agents/rules/maintain_context.md"
else
    echo -e "  ${YELLOW}[*] Preserved:${NC} .agents/rules/maintain_context.md (use --force to overwrite)"
fi

# 3. GEMINI.md
GEMINI_FILE="$PROJECT_DIR/GEMINI.md"
if [ ! -f "$GEMINI_FILE" ] || [ "$FORCE" = true ]; then
    if [ "$DRY_RUN" = false ]; then
cat << GEMINI_EOF > "$GEMINI_FILE"
# Standing Agent Rules for $PROJECT_NAME

## Critical Mandate: Autonomous \`context.md\` Synchronization & Self-Evolution
As an AI coding assistant working in this repository (\`$PROJECT_DIR\`), you are **strictly mandated** to keep \`$PROJECT_DIR/context.md\` continuously up to date and autonomously learn, persist, and crystallize new rules and skills. The user must **never** need to remind or instruct you.

### 1. Mandatory Post-Action Protocol
Whenever ANY of the following events occur in any session or conversation turn:
- A configuration file or script is created, edited, moved, or deleted.
- A problem, bug, or error is encountered and diagnosed.
- Credentials, tokens, user accounts, or security keys are generated or updated.
- Architectural decisions or operational steps are modified.

**You MUST immediately update \`$PROJECT_DIR/context.md\` before finalizing your response.**

### 2. Autonomous Learning & Self-Evolution Protocol
Whenever you learn a new pattern, receive a correction, observe a coding preference, or resolve a complex repeatable problem:
1. **Identify the Type:**
   - **Rule:** If it is a constraint, coding standard, safety boundary, or architectural preference -> Create a Rule (\`init-context -r <name>\`).
   - **Skill:** If it is a multi-step procedure, deployment workflow, diagnosis runbook, or CLI sequence -> Create a Skill (\`init-context -s <name>\`).
2. **Scope Decision:**
   - **Project-Specific:** Save in \`.agents/rules/\` or \`.agents/skills/\`.
   - **Machine-Wide / Global:** If it applies to all projects, use \`--global\` (\`-g\`) to register in \`~/.gemini/config/plugins/auto-context/\`.
3. **Execution:**
   - Use the \`init-context\` CLI tool to scaffold the file.
   - Populate it with clear objectives, constraints, or step-by-step instructions.
   - Inform the user of the new rule or skill codified.

### 3. Tool Access: \`init-context\`
You have native access to run \`init-context\` via terminal commands:
- \`init-context\`: Scaffolds or repairs project context.
- \`init-context -r <rule-name> [-g]\`: Creates a new rule with frontmatter.
- \`init-context -s <skill-name> [-g]\`: Creates a new skill with frontmatter.

### 4. Required Content & Structure in \`context.md\`
1. **Master Credentials & Configuration Vault (Section 1):** Keep all ports, IPs, secrets, tokens, and endpoints synchronized.
2. **Chronological Problem Log & Technical Solutions (Section 2):** Document symptom, root cause, exact commands/code used, and update Mermaid diagram.
3. **Architecture & Component Layout (Section 3):** Keep stack overview and directory maps accurate.
4. **Operations Runbook (Section 4):** Ensure 1-step reproduction instructions remain functional.
GEMINI_EOF
    fi
    echo -e "  ${GREEN}[✓] Generated:${NC} GEMINI.md"
else
    echo -e "  ${YELLOW}[*] Preserved:${NC} GEMINI.md"
fi

# 4. AGENTS.md
AGENTS_FILE="$PROJECT_DIR/AGENTS.md"
if [ ! -f "$AGENTS_FILE" ] || [ "$FORCE" = true ]; then
    if [ "$DRY_RUN" = false ]; then
        cp "$GEMINI_FILE" "$AGENTS_FILE"
    fi
    echo -e "  ${GREEN}[✓] Generated:${NC} AGENTS.md"
else
    echo -e "  ${YELLOW}[*] Preserved:${NC} AGENTS.md"
fi

# 5. context.md
CONTEXT_FILE="$PROJECT_DIR/context.md"
if [ ! -f "$CONTEXT_FILE" ] || [ "$FORCE" = true ]; then
    if [ "$DRY_RUN" = false ]; then
cat << CTX_EOF > "$CONTEXT_FILE"
# $PROJECT_NAME — Master Architectural Context, Problem Log & Operations Manual

> **Last Updated:** $DATE_NOW  
> **Project Directory:** \`$PROJECT_DIR\`  
> **Repository Name:** \`$PROJECT_NAME\`  
> **Primary Stack:** $STACK ($FRAMEWORK)  

---

## 1. Master Credentials & Configuration Vault

| Property | Value / Setting | Description |
| :--- | :--- | :--- |
| **Project Name** | \`$PROJECT_NAME\` | Active project identifier |
| **Environment** | Development / Production | Current runtime environment |
| **Base Port** | TBD | Application listening port |
| **API Endpoints** | TBD | Service URL / Domains |
| **Secrets / Keys** | Secured in Vault | Credentials, API tokens, passwords |

---

## 2. Chronological Problem Log & Technical Solutions

\`\`\`mermaid
flowchart TD
    Init["1. Project Initialized"] --> Ready["Ready for development"]
\`\`\`

| # | Symptom / Error Message | Root Cause | Exact CLI Solution & Code Patch |
| :-: | :--- | :--- | :--- |
| 1 | Initial setup | Clean repository initialization | Generated autonomous context framework |

---

## 3. System Architecture & Tech Stack

* **Primary Stack:** $STACK
* **Framework:** $FRAMEWORK
* **Database / Cache:** TBD
* **Deployment Target:** TBD

```
$PROJECT_NAME/
